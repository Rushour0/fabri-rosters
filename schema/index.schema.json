{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fabri registry index",
  "type": "object",
  "required": ["agencies", "rosters"],
  "properties": {
    "agencies": {"type": "array", "items": {"type": "object", "required": ["name", "title", "tagline", "category", "deliverable", "entry", "agents", "tools", "max_cost_usd", "provider", "self_improving", "cogs_reported", "path"]}},
    "rosters": {"type": "array", "items": {"type": "object", "required": ["name", "title", "tagline", "positioning", "members", "path"]}}
  }
}
